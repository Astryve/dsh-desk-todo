{
  "name": "dsh-desk-todo",
  "version": "2.0.2",
  "description": "DSH 桌面待办挂件：Electron 透明窗口（找不到 Electron 时自动退回 WPF），到点弹窗 + 提示音提醒。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "app",
    "win",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "todo",
    "desktop",
    "widget",
    "reminder",
    "待办",
    "桌面挂件"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.5": "compatible",
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "os": [
    "win32"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Astryve/dsh-desk-todo.git"
  },
  "homepage": "https://github.com/Astryve/dsh-desk-todo#readme",
  "bugs": {
    "url": "https://github.com/Astryve/dsh-desk-todo/issues"
  },
  "author": "astryve"
}